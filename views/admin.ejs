<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'لوحة التحكم - NFC Pro' %></title>
    
    <!-- ========== رؤوس الأمان ========== -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <meta http-equiv="X-Frame-Options" content="DENY">
    <meta http-equiv="X-XSS-Protection" content="1; mode=block">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <!-- ========== نهاية رؤوس الأمان ========== -->
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        /* جميع الأنماط كما هي - لم يتم تغيير أي شيء */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f4f9fe;
            color: #1e293b;
            min-height: 100vh;
            position: relative;
        }

        /* خلفية متحركة فاتحة */
        .background {
            position: fixed;
            width: 100vw;
            height: 100vh;
            top: 0;
            left: 0;
            z-index: -1;
            overflow: hidden;
        }

        .gradient-orb {
            position: absolute;
            width: 80vmax;
            height: 80vmax;
            background: radial-gradient(circle at 30% 50%, rgba(147, 197, 253, 0.5) 0%, rgba(165, 180, 252, 0.4) 50%, transparent 70%);
            border-radius: 50%;
            top: -20%;
            right: -20%;
            animation: floatOrb 30s ease-in-out infinite;
        }

        .gradient-orb-2 {
            position: absolute;
            width: 70vmax;
            height: 70vmax;
            background: radial-gradient(circle at 70% 50%, rgba(216, 180, 254, 0.4) 0%, rgba(187, 222, 252, 0.4) 50%, transparent 70%);
            border-radius: 50%;
            bottom: -20%;
            left: -20%;
            animation: floatOrb 35s ease-in-out infinite reverse;
        }

        @keyframes floatOrb {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(-5%, 5%) scale(1.05); }
        }

        .particles {
            position: absolute;
            width: 100%;
            height: 100%;
            background-image: 
                radial-gradient(circle at 20% 30%, rgba(59, 130, 246, 0.06) 1.5px, transparent 1.5px),
                radial-gradient(circle at 80% 70%, rgba(139, 92, 246, 0.05) 1px, transparent 1px);
            background-size: 130px 130px;
            animation: moveParticles 50s linear infinite;
            opacity: 0.4;
        }

        @keyframes moveParticles {
            0% { background-position: 0 0, 0 0; }
            100% { background-position: 200px 200px, -150px 100px; }
        }

        /* الحاوية الرئيسية */
        .admin-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 30px 20px;
            position: relative;
            z-index: 1;
        }

        /* الهيدر */
        .admin-header {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(18px);
            border-radius: 40px;
            padding: 30px;
            margin-bottom: 30px;
            border: 1px solid rgba(255,255,255,0.7);
            box-shadow: 0 20px 40px -20px rgba(0,80,120,0.2);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .admin-header h1 {
            font-size: 2rem;
            font-weight: 700;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .admin-header h1 i {
            background: linear-gradient(145deg, #3b82f6, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .admin-stats {
            display: flex;
            gap: 20px;
        }

        .stat-box {
            background: white;
            border-radius: 24px;
            padding: 15px 25px;
            display: flex;
            flex-direction: column;
            align-items: center;
            border: 1px solid #e2e8f0;
            box-shadow: 0 10px 25px -12px rgba(0,0,0,0.1);
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: #3b82f6;
            line-height: 1.2;
        }

        .stat-label {
            color: #64748b;
            font-size: 0.9rem;
        }

        /* الأقسام */
        .admin-section {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(18px);
            border-radius: 40px;
            padding: 30px;
            margin-bottom: 30px;
            border: 1px solid rgba(255,255,255,0.7);
            box-shadow: 0 20px 40px -20px rgba(0,80,120,0.2);
        }

        .admin-section h2 {
            font-size: 1.5rem;
            font-weight: 600;
            color: #0f172a;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .admin-section h2 i {
            background: linear-gradient(145deg, #3b82f6, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* رسائل التنبيه */
        .alert {
            padding: 16px 24px;
            border-radius: 20px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 500;
            animation: slideDown 0.3s ease;
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .alert.success {
            background: #f0fdf4;
            border: 1px solid #86efac;
            color: #166534;
        }

        .alert.error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
        }

        .alert i {
            font-size: 1.2rem;
        }

        /* النموذج */
        .card-form {
            background: white;
            border-radius: 32px;
            padding: 30px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 10px 25px -12px rgba(0,0,0,0.1);
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 0;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #334155;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 14px 18px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            font-size: 0.95rem;
            color: #0f172a;
            transition: all 0.3s ease;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #3b82f6;
            background: white;
            box-shadow: 0 4px 12px rgba(59,130,246,0.1);
        }

        .form-group input[dir="ltr"] {
            text-align: left;
        }

        .btn-submit {
            background: linear-gradient(145deg, #3b82f6, #8b5cf6);
            color: white;
            border: none;
            padding: 16px 40px;
            border-radius: 40px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 12px 28px -10px #3b82f6;
        }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 20px 35px -8px #3b82f6;
        }

        /* قائمة البطاقات */
        .cards-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 20px;
        }

        .card-item {
            background: white;
            border-radius: 28px;
            padding: 25px;
            border: 1px solid #e2e8f0;
            transition: all 0.3s ease;
            box-shadow: 0 10px 25px -12px rgba(0,0,0,0.1);
        }

        .card-item:hover {
            transform: translateY(-5px);
            border-color: #a5b4fc;
            box-shadow: 0 20px 35px -18px #3b82f6;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px solid #e2e8f0;
        }

        .card-header h3 {
            color: #0f172a;
            font-size: 1.2rem;
            font-weight: 600;
        }

        .card-id {
            background: #eef2ff;
            color: #3b82f6;
            padding: 6px 15px;
            border-radius: 40px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .card-body {
            margin-bottom: 20px;
        }

        .card-body p {
            color: #64748b;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.95rem;
        }

        .card-body i {
            color: #3b82f6;
            width: 20px;
        }

        .card-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-view,
        .btn-edit,
        .btn-delete {
            padding: 10px 20px;
            border-radius: 40px;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-view {
            background: #eef2ff;
            color: #3b82f6;
            border: 1px solid #a5b4fc;
        }

        .btn-edit {
            background: #f0f9ff;
            color: #0284c7;
            border: 1px solid #7dd3fc;
        }

        .btn-delete {
            background: #fef2f2;
            color: #dc2626;
            border: 1px solid #fecaca;
        }

        .btn-view:hover,
        .btn-edit:hover,
        .btn-delete:hover {
            transform: translateY(-2px);
            filter: brightness(0.95);
        }

        /* جدول الزيارات */
        .visits-table {
            overflow-x: auto;
            background: white;
            border-radius: 28px;
            border: 1px solid #e2e8f0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead tr {
            background: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
        }

        th {
            text-align: right;
            padding: 18px 20px;
            color: #334155;
            font-weight: 600;
            font-size: 0.95rem;
        }

        td {
            padding: 15px 20px;
            color: #64748b;
            border-bottom: 1px solid #e2e8f0;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background: #f8fafc;
        }

        /* قسم التحكم Lava Lamp */
        .lava-control {
            background: white;
            border-radius: 28px;
            padding: 25px;
            border: 1px solid #e2e8f0;
            margin-bottom: 20px;
        }

        .lava-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .lava-header i {
            font-size: 1.5rem;
            color: #3b82f6;
        }

        .lava-header h5 {
            font-size: 1.2rem;
            color: #0f172a;
        }

        .form-check {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 15px;
        }

        .form-check-input {
            width: 50px;
            height: 26px;
            appearance: none;
            background: #cbd5e1;
            border-radius: 30px;
            position: relative;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .form-check-input:checked {
            background: linear-gradient(145deg, #3b82f6, #8b5cf6);
        }

        .form-check-input::before {
            content: '';
            position: absolute;
            width: 22px;
            height: 22px;
            background: white;
            border-radius: 50%;
            top: 2px;
            right: 2px;
            transition: all 0.3s ease;
        }

        .form-check-input:checked::before {
            right: calc(100% - 24px);
        }

        .form-check-label {
            color: #334155;
            font-weight: 500;
        }

        .form-select {
            width: 100%;
            padding: 12px 18px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            color: #0f172a;
            font-family: 'Plus Jakarta Sans', sans-serif;
            cursor: pointer;
        }

        .btn-primary {
            background: linear-gradient(145deg, #3b82f6, #8b5cf6);
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 40px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px -8px #3b82f6;
        }

        /* شارة الأمان */
        .security-badge {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.6rem;
            color: #10b981;
            font-family: monospace;
            z-index: 999;
            pointer-events: none;
        }

        /* تصميم متجاوب */
        @media (max-width: 768px) {
            .admin-header {
                flex-direction: column;
                text-align: center;
            }

            .admin-stats {
                width: 100%;
                justify-content: center;
            }

            .cards-list {
                grid-template-columns: 1fr;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .card-actions {
                flex-direction: column;
            }

            .btn-view,
            .btn-edit,
            .btn-delete {
                width: 100%;
                justify-content: center;
            }
        }

        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #e2e8f0;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(145deg, #a5b4fc, #bae6fd);
            border-radius: 10px;
        }
    </style>
</head>
<body>
    
    
    <div class="background">
        <div class="gradient-orb"></div>
        <div class="gradient-orb-2"></div>
        <div class="particles"></div>
    </div>

    <div class="admin-container">
        <header class="admin-header">
            <h1>
                <i class="fas fa-cogs"></i>
                لوحة التحكم - بطاقات NFC
            </h1>
            <div class="admin-stats">
                <div class="stat-box">
                <span class="stat-number"><%= profiles ? profiles.length : 0 %></span>
                <span class="stat-label">إجمالي البطاقات NFC</span>
                </div>
                <div class="stat-box">
                    <span class="stat-number"><%= visits ? visits.length : 0 %></span>
                    <span class="stat-label">إجمالي الزيارات</span>
                </div>
            </div>
        </header>

        <!-- رسائل النجاح والخطأ (مع تنقية) -->
        <% if (query && query.success) { 
            const cleanSuccess = String(query.success).replace(/[<>]/g, '');
        %>
        <div class="alert success"><i class="fas fa-check-circle"></i> <%= cleanSuccess %></div>
        <% } %>
        <% if (query && query.error) { 
            const cleanError = String(query.error).replace(/[<>]/g, '');
        %>
        <div class="alert error"><i class="fas fa-exclamation-circle"></i> <%= cleanError %></div>
        <% } %>

        <!-- نموذج إضافة بطاقة جديدة -->
        <div class="admin-section">
            <h2><i class="fas fa-plus-circle"></i> إضافة بطاقة جديدة</h2>
            <form action="/admin/card/add" method="POST" class="card-form" id="addCardForm">
                <!-- إضافة CSRF Token -->
                <input type="hidden" name="csrf_token" id="csrfToken" value="">
                
                <div class="form-grid">
                    <div class="form-group">
                        <label>معرف البطاقة (NFC ID):</label>
                        <input type="text" name="cardId" placeholder="nfc-001" required maxlength="100">
                    </div>
                    <div class="form-group">
                        <label>الاسم الكامل:</label>
                        <input type="text" name="name" required maxlength="200">
                    </div>
                    <div class="form-group">
                        <label>المسمى الوظيفي:</label>
                        <input type="text" name="title" required maxlength="200">
                    </div>
                    <div class="form-group">
                        <label>الشركة:</label>
                        <input type="text" name="company" maxlength="200">
                    </div>
                    <div class="form-group">
                        <label>البريد الإلكتروني:</label>
                        <input type="email" name="email" maxlength="200">
                    </div>
                    <div class="form-group">
                        <label>رقم الجوال:</label>
                        <input type="tel" name="phone" dir="ltr" maxlength="50">
                    </div>
                    <div class="form-group">
                        <label>الموقع الإلكتروني:</label>
                        <input type="url" name="website" dir="ltr" maxlength="500">
                    </div>
                    <div class="form-group">
                        <label>العنوان:</label>
                        <input type="text" name="address" maxlength="500">
                    </div>
                    <div class="form-group full-width">
                        <label>نبذة تعريفية:</label>
                        <textarea name="bio" rows="3" maxlength="1000"></textarea>
                    </div>
                    <div class="form-group">
                        <label>LinkedIn:</label>
                        <input type="url" name="linkedin" dir="ltr" maxlength="500">
                    </div>
                    <div class="form-group">
                        <label>Twitter/X:</label>
                        <input type="url" name="twitter" dir="ltr" maxlength="500">
                    </div>
                    <div class="form-group">
                        <label>GitHub:</label>
                        <input type="url" name="github" dir="ltr" maxlength="500">
                    </div>
                    <div class="form-group full-width">
                        <label>رابط ديناميكي:</label>
                        <input type="url" name="dynamicLink" dir="ltr" placeholder="https://..." maxlength="500">
                    </div>
                </div>
                <button type="submit" class="btn-submit">
                    <i class="fas fa-save"></i>
                    إضافة البطاقة
                </button>
            </form>
        </div>

        <!-- قائمة البطاقات الموجودة (مع تنقية البيانات) -->
        <div class="admin-section">
            <h2><i class="fas fa-list"></i> البطاقات الموجودة</h2>
            <div class="cards-list">
                <% if (profiles && profiles.length > 0) { %>
                    <% profiles.forEach(card => { 
                        const cleanName = String(card.name || '').replace(/[<>]/g, '');
                        const cleanTitle = String(card.title || '').replace(/[<>]/g, '');
                        const cleanCompany = String(card.company || '').replace(/[<>]/g, '');
                        const cleanPhone = String(card.phone || 'غير متوفر').replace(/[<>]/g, '');
                        const cleanEmail = String(card.email || 'غير متوفر').replace(/[<>]/g, '');
                        const cardIdValue = String(card.cardId || card.profileId || '').replace(/[<>]/g, '');
                    %>
                    <div class="card-item">
                        <div class="card-header">
                            <h3><%= cleanName %></h3>
                            <span class="card-id"><%= cardIdValue %></span>
                        </div>
                        <div class="card-body">
                            <p><i class="fas fa-briefcase"></i> <%= cleanTitle %> <%= cleanCompany ? '- ' + cleanCompany : '' %></p>
                            <p><i class="fas fa-phone"></i> <%= cleanPhone %></p>
                            <p><i class="fas fa-envelope"></i> <%= cleanEmail %></p>
                        </div>
                        <div class="card-actions">
                            <a href="/p/<%= cardIdValue %>" target="_blank" class="btn-view" data-href="/p/<%= cardIdValue %>">
                                <i class="fas fa-eye"></i> عرض
                            </a>
                            <a href="/admin/card/edit/<%= cardIdValue %>" class="btn-edit" data-href="/admin/card/edit/<%= cardIdValue %>">
                                <i class="fas fa-edit"></i> تعديل
                            </a>
                            <form action="/admin/card/delete/<%= cardIdValue %>" 
                                  method="POST" 
                                  style="display:inline;"
                                  class="delete-form"
                                  onsubmit="return confirmDelete();">
                                <input type="hidden" name="csrf_token" value="">
                                <button type="submit" class="btn-delete">
                                    <i class="fas fa-trash"></i> حذف
                                </button>
                            </form>
                        </div>
                    </div>
                    <% }) %>
                <% } else { %>
                    <p style="color: #64748b; text-align: center; padding: 40px;">لا توجد بطاقات مضافة بعد</p>
                <% } %>
            </div>
        </div>
        
        <!-- سجل الزيارات مع الدولة وIP مشفر (مع تنقية البيانات) -->
        <div class="admin-section">
            <h2><i class="fas fa-chart-line"></i> سجل الزيارات</h2>
            <div class="visits-table">
                <table>
                    <thead>
                        <tr>
                            <th>البطاقة</th>
                            <th>التاريخ والوقت</th>
                            <th>الدولة</th>
                            <th>IP (مشفر)</th>
                            <th>المتصفح</th>
                            <th>نظام التشغيل</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (visits && visits.length > 0) { %>
                            <% 
                            const recentVisits = visits.slice(0, 20);
                            recentVisits.forEach(visit => { 
                                const cardIdentifier = String(visit.cardId || visit.profileId || 'غير معروف').replace(/[<>]/g, '');
                                
                                let visitDate = 'تاريخ غير معروف';
                                const dateValue = visit.timestamp || visit.createdAt;
                                if (dateValue) {
                                    try {
                                        visitDate = new Date(dateValue).toLocaleString('ar-SA', {
                                            year: 'numeric',
                                            month: 'numeric',
                                            day: 'numeric',
                                            hour: '2-digit',
                                            minute: '2-digit',
                                            second: '2-digit'
                                        }).replace(/[<>]/g, '');
                                    } catch(e) {
                                        visitDate = 'تاريخ غير صالح';
                                    }
                                }
                                
                                let ipAddress = visit.ip || visit.ipAddress || 'غير معروف';
                                let encryptedIP = String(ipAddress).replace(/[<>]/g, '');
                                if (ipAddress !== 'غير معروف' && ipAddress !== '127.0.0.1' && ipAddress !== '::1') {
                                    if (ipAddress.includes('.')) {
                                        const ipParts = ipAddress.split('.');
                                        if (ipParts.length === 4) {
                                            encryptedIP = `${ipParts[0]}.${ipParts[1]}.${ipParts[2]}.***`;
                                        }
                                    } else if (ipAddress.includes(':')) {
                                        encryptedIP = ipAddress.substring(0, 8) + '...';
                                    }
                                }
                                
                                const country = String(visit.country || 'غير معروف').replace(/[<>]/g, '');
                                const countryFlag = String(visit.countryFlag || '🌐').replace(/[<>]/g, '');
                                
                                let browser = 'غير معروف';
                                const ua = String(visit.userAgent || '');
                                
                                if (ua.includes('Chrome') && !ua.includes('Edg')) browser = 'Google Chrome';
                                else if (ua.includes('Firefox')) browser = 'Mozilla Firefox';
                                else if (ua.includes('Safari') && !ua.includes('Chrome')) browser = 'Apple Safari';
                                else if (ua.includes('Edg')) browser = 'Microsoft Edge';
                                else if (ua.includes('OPR') || ua.includes('Opera')) browser = 'Opera';
                                else if (ua.includes('MSIE') || ua.includes('Trident')) browser = 'Internet Explorer';
                                else if (ua) browser = ua.split(' ')[0].substring(0, 20).replace(/[<>]/g, '');
                                
                                let os = 'غير معروف';
                                if (ua.includes('Windows NT 10.0')) os = 'Windows 10/11';
                                else if (ua.includes('Windows NT 6.3')) os = 'Windows 8.1';
                                else if (ua.includes('Windows NT 6.2')) os = 'Windows 8';
                                else if (ua.includes('Windows NT 6.1')) os = 'Windows 7';
                                else if (ua.includes('Mac OS X')) os = 'macOS';
                                else if (ua.includes('iPhone')) os = 'iOS (iPhone)';
                                else if (ua.includes('iPad')) os = 'iOS (iPad)';
                                else if (ua.includes('Android')) os = 'Android';
                                else if (ua.includes('Linux')) os = 'Linux';
                            %>
                            <tr>
                                <td><%= cardIdentifier %></td>
                                <td><%= visitDate %></td>
                                <td>
                                    <span style="display: flex; align-items: center; gap: 5px;">
                                        <span><%= countryFlag %></span>
                                        <span><%= country %></span>
                                    </span>
                                </td>
                                <td><%= encryptedIP %></td>
                                <td><%= browser %></td>
                                <td><%= os %></td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" style="text-align: center; color: #64748b; padding: 40px;">
                                    <i class="fas fa-info-circle"></i> لا توجد زيارات بعد
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- قسم التحكم في Lava Lamp -->
        <div class="admin-section">
            <h2><i class="fas fa-palette"></i> التحكم في تأثير Lava Lamp</h2>
            <div class="lava-control">
                <div class="lava-header">
                    <i class="fas fa-fire"></i>
                    <h5>إعدادات التأثير</h5>
                </div>
                <div class="row">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="lavaLampToggle" 
                               <%= enableLavaLamp ? 'checked' : '' %>>
                        <label class="form-check-label" for="lavaLampToggle">
                            تفعيل تأثير Lava Lamp
                        </label>
                    </div>
                    <div style="margin-bottom: 15px;">
                        <select class="form-select" id="lavaIntensity">
                            <option value="low">منخفض</option>
                            <option value="medium" selected>متوسط</option>
                            <option value="high">عالي</option>
                        </select>
                    </div>
                </div>
                <button class="btn-primary" onclick="saveLavaSettings()">
                    <i class="fas fa-save"></i>
                    حفظ الإعدادات
                </button>
            </div>
        </div>
    </div>

    <script>
        // ========== طبقات الحماية المضافة ==========
        
        // 1. توليد CSRF Token للحماية من هجمات CSRF
        function generateCSRFToken() {
            const array = new Uint8Array(32);
            if (window.crypto && window.crypto.getRandomValues) {
                window.crypto.getRandomValues(array);
            } else {
                for (let i = 0; i < array.length; i++) {
                    array[i] = Math.floor(Math.random() * 256);
                }
            }
            return Array.from(array, byte => byte.toString(16).padStart(2, '0')).join('');
        }
        
        const csrfToken = generateCSRFToken();
        console.log('🛡️ لوحة التحكم - CSRF Token:', csrfToken);
        
        // 2. دالة تنقية النصوص من XSS
        function sanitizeText(text) {
            if (!text) return '';
            const element = document.createElement('div');
            element.textContent = text;
            return element.textContent;
        }
        
        // 3. دالة تنقية URL
        function sanitizeUrl(url) {
            if (!url) return '';
            const dangerous = ['javascript:', 'data:', 'vbscript:', 'file:'];
            for (let i = 0; i < dangerous.length; i++) {
                if (url.toLowerCase().startsWith(dangerous[i])) {
                    return '#';
                }
            }
            return url;
        }
        
        // 4. منع تنفيذ أي كود ضار في وحدة التحكم
        function preventConsoleInjection() {
            const originalConsoleError = console.error;
            console.error = function() {
                const args = Array.from(arguments);
                if (args.some(arg => typeof arg === 'string' && (arg.includes('<script') || arg.includes('onerror')))) {
                    return;
                }
                originalConsoleError.apply(console, args);
            };
        }
        
        // 5. منع إضافة عناصر ضارة ديناميكياً
        function preventDynamicScripts() {
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    mutation.addedNodes.forEach(function(node) {
                        if (node.nodeName === 'SCRIPT' || (node.nodeType === 1 && node.innerHTML && node.innerHTML.includes('<script'))) {
                            node.remove();
                            console.warn('🛡️ تم منع إضافة عنصر ضار');
                        }
                    });
                });
            });
            observer.observe(document.body, { childList: true, subtree: true });
        }
        
        // 6. حماية الروابط في الصفحة
        function protectLinks() {
            const allLinks = document.querySelectorAll('a');
            allLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (href) {
                    const sanitizedHref = sanitizeUrl(href);
                    if (sanitizedHref !== href) {
                        link.setAttribute('href', sanitizedHref);
                    }
                }
            });
        }
        
        // 7. حماية النماذج
        function protectForms() {
            // إضافة CSRF Token لجميع النماذج
            const forms = document.querySelectorAll('form');
            forms.forEach(form => {
                const existingToken = form.querySelector('input[name="csrf_token"]');
                if (!existingToken) {
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = 'csrf_token';
                    tokenInput.value = csrfToken;
                    form.appendChild(tokenInput);
                } else {
                    existingToken.value = csrfToken;
                }
            });
        }
        
        // 8. دالة تأكيد الحذف مع تنقية
        function confirmDelete() {
            return confirm('هل أنت متأكد من حذف هذه البطاقة؟');
        }
        
        // 9. تنقية الإدخالات في النماذج
        function sanitizeFormInputs() {
            const inputs = document.querySelectorAll('input, textarea');
            inputs.forEach(input => {
                if (input.type !== 'password' && input.type !== 'hidden') {
                    input.addEventListener('input', function(e) {
                        if (this.value && (this.value.includes('<') || this.value.includes('>'))) {
                            this.value = this.value.replace(/[<>]/g, '');
                        }
                    });
                }
            });
        }
        
        // ========== الكود الأصلي مع تحسينات الأمان ==========
        
        // دالة تعديل البطاقة
        function editCard(cardId) {
            const sanitizedId = sanitizeText(cardId);
            window.location.href = `/admin/card/edit/${sanitizedId}`;
        }

        // حفظ إعدادات Lava Lamp
        function saveLavaSettings() {
            const enabled = document.getElementById('lavaLampToggle').checked;
            const intensity = document.getElementById('lavaIntensity').value;
            
            fetch('/api/lava-lamp/settings', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken
                },
                body: JSON.stringify({ 
                    enabled, 
                    intensity, 
                    interactive: true, 
                    autoColor: true,
                    csrf_token: csrfToken
                })
            })
            .then(res => res.json())
            .then(data => {
                alert('تم حفظ الإعدادات بنجاح');
                if (enabled) {
                    location.reload();
                }
            })
            .catch(error => {
                console.error('خطأ:', error);
                alert('حدث خطأ في حفظ الإعدادات');
            });
        }

        // تحديث الإحصائيات كل 30 ثانية
        let refreshInterval = setInterval(() => {
            location.reload();
        }, 30000);
        
        // إيقاف التحديث عند مغادرة الصفحة
        window.addEventListener('beforeunload', function() {
            if (refreshInterval) {
                clearInterval(refreshInterval);
            }
        });

        // تأثيرات تفاعلية
        document.addEventListener('DOMContentLoaded', function() {
            // تفعيل جميع طبقات الحماية
            protectLinks();
            protectForms();
            sanitizeFormInputs();
            preventConsoleInjection();
            preventDynamicScripts();
            
            console.log('🛡️ لوحة التحكم - جميع طبقات الحماية مفعلة بنجاح!');
            
            // إضافة تأثير hover للحقول
            const inputs = document.querySelectorAll('input, textarea, select');
            inputs.forEach(input => {
                input.addEventListener('focus', function() {
                    this.style.transform = 'scale(1.01)';
                });
                input.addEventListener('blur', function() {
                    this.style.transform = 'scale(1)';
                });
            });
            
            // حماية الروابط في الأزرار
            const viewBtns = document.querySelectorAll('.btn-view');
            viewBtns.forEach(btn => {
                const href = btn.getAttribute('href');
                if (href) {
                    btn.setAttribute('href', sanitizeUrl(href));
                }
            });
            
            const editBtns = document.querySelectorAll('.btn-edit');
            editBtns.forEach(btn => {
                const href = btn.getAttribute('href');
                if (href) {
                    btn.setAttribute('href', sanitizeUrl(href));
                }
            });
        });
        
        // تصدير الدوال للاستخدام العالمي
        window.editCard = editCard;
        window.saveLavaSettings = saveLavaSettings;
        window.confirmDelete = confirmDelete;
    </script>
</body>
</html>