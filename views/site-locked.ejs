<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>
        <%= title %>
    </title>

    <!-- ========== رؤوس الأمان ========== -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <meta http-equiv="X-Frame-Options" content="DENY">
    <meta http-equiv="X-XSS-Protection" content="1; mode=block">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <!-- ========== نهاية رؤوس الأمان ========== -->

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Tajawal', sans-serif;
            background: linear-gradient(145deg, #fef9e6 0%, #f0f7ff 50%, #fef5e8 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            direction: rtl;
            padding: 20px;
            position: relative;
            overflow-x: hidden;
        }

        .bg-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            overflow: hidden;
        }

        .bubble {
            position: absolute;
            border-radius: 50%;
            background: linear-gradient(145deg, rgba(59, 130, 246, 0.08), rgba(139, 92, 246, 0.05));
            animation: floatBubble 25s infinite ease-in-out;
        }

        .bubble-1 {
            width: 350px;
            height: 350px;
            top: -100px;
            right: -100px;
            animation-delay: 0s;
        }

        .bubble-2 {
            width: 250px;
            height: 250px;
            bottom: -50px;
            left: -50px;
            animation-delay: 5s;
        }

        .bubble-3 {
            width: 200px;
            height: 200px;
            top: 40%;
            right: 20%;
            animation-delay: 10s;
        }

        .bubble-4 {
            width: 150px;
            height: 150px;
            bottom: 20%;
            left: 30%;
            animation-delay: 15s;
        }

        @keyframes floatBubble {

            0%,
            100% {
                transform: translate(0, 0) scale(1);
                opacity: 0.4;
            }

            50% {
                transform: translate(-30px, -30px) scale(1.1);
                opacity: 0.6;
            }
        }

        .flower {
            position: absolute;
            color: rgba(251, 191, 36, 0.15);
            font-size: 40px;
            pointer-events: none;
        }

        .flower-1 {
            top: 10%;
            left: 5%;
            animation: spin 30s linear infinite;
        }

        .flower-2 {
            bottom: 15%;
            right: 8%;
            animation: spin 25s linear infinite reverse;
        }

        .flower-3 {
            top: 20%;
            right: 15%;
            animation: spin 35s linear infinite;
        }

        @keyframes spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .lock-container {
            position: relative;
            z-index: 1;
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(15px);
            border-radius: 48px;
            padding: 50px;
            max-width: 550px;
            width: 100%;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 25px 45px -12px rgba(0, 0, 0, 0.1), 0 2px 5px rgba(0, 0, 0, 0.02);
            animation: slideUp 0.6s cubic-bezier(0.2, 0.9, 0.4, 1.1) forwards;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .lock-header {
            margin-bottom: 35px;
        }

        .lock-icon-wrapper {
            width: 90px;
            height: 90px;
            background: linear-gradient(135deg, #fff9e6, #fff5e0);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            border: 2px solid #fde68a;
            animation: softPulse 2s infinite;
        }

        @keyframes softPulse {

            0%,
            100% {
                box-shadow: 0 0 0 0 rgba(251, 191, 36, 0.3);
                border-color: #fde68a;
            }

            50% {
                box-shadow: 0 0 0 12px rgba(251, 191, 36, 0);
                border-color: #fbbf24;
            }
        }

        .lock-icon-wrapper i {
            font-size: 42px;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        h1 {
            font-size: 1.8rem;
            font-weight: 800;
            background: linear-gradient(135deg, #1e293b, #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 12px;
        }

        .subtitle {
            color: #64748b;
            font-size: 0.9rem;
        }

        .expiry-message {
            background: linear-gradient(135deg, #fff5f0, #fee2e2);
            border-radius: 28px;
            padding: 20px;
            margin: 25px 0;
            text-align: center;
            border: 1px solid #fecaca;
        }

        .expiry-message i {
            font-size: 2rem;
            color: #f97316;
            margin-bottom: 10px;
            display: inline-block;
        }

        .expiry-message p {
            color: #9b2c1d;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .expiry-date {
            font-size: 1.1rem;
            font-weight: 800;
            background: white;
            color: #ea580c;
            padding: 8px 20px;
            border-radius: 50px;
            display: inline-block;
            margin-top: 8px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
        }

        .active-message {
            background: linear-gradient(135deg, #f0fdf4, #dcfce7);
            border-radius: 28px;
            padding: 25px;
            margin: 25px 0;
            text-align: center;
            border: 1px solid #bbf7d0;
        }

        .active-message i {
            font-size: 3rem;
            color: #22c55e;
            margin-bottom: 10px;
            display: inline-block;
            animation: checkBounce 0.5s ease-out;
        }

        @keyframes checkBounce {
            0% {
                transform: scale(0);
                opacity: 0;
            }

            50% {
                transform: scale(1.2);
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        .active-message h3 {
            color: #15803d;
            font-size: 1.2rem;
            margin-bottom: 8px;
        }

        .active-message p {
            color: #4b5563;
            font-size: 0.9rem;
        }

        .active-message .expiry-date {
            background: #22c55e;
            color: white;
            margin-top: 12px;
        }

        .unlock-form {
            margin-top: 30px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper i {
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1rem;
            transition: all 0.3s ease;
            pointer-events: none;
        }

        .input-wrapper input {
            width: 100%;
            padding: 15px 50px 15px 20px;
            border: 2px solid #e2e8f0;
            border-radius: 60px;
            font-size: 1rem;
            transition: all 0.3s ease;
            font-family: 'Tajawal', sans-serif;
            background: white;
            color: #1e293b;
            direction: ltr;
            text-align: right;
        }

        .input-wrapper input::placeholder {
            color: #cbd5e1;
        }

        .input-wrapper input:focus {
            border-color: #f59e0b;
            outline: none;
            box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.1);
        }

        .input-wrapper input:focus+i {
            color: #f59e0b;
        }

        button {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            border: none;
            border-radius: 60px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Tajawal', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            position: relative;
            overflow: hidden;
        }

        button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.5s ease;
        }

        button:hover::before {
            left: 100%;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(245, 158, 11, 0.4);
        }

        .error-message {
            background: #fff5f0;
            border-radius: 60px;
            padding: 12px 20px;
            margin-top: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            justify-content: center;
            border: 1px solid #fed7aa;
            animation: shakeError 0.4s ease;
        }

        @keyframes shakeError {

            0%,
            100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-5px);
            }

            75% {
                transform: translateX(5px);
            }
        }

        .error-message i {
            color: #f97316;
            font-size: 1rem;
        }

        .error-message span {
            color: #c2410c;
        }

        .note {
            margin-top: 30px;
            padding-top: 25px;
            border-top: 1px solid #f1f5f9;
            font-size: 0.8rem;
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .note a {
            color: #f59e0b;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: all 0.3s ease;
        }

        .note a:hover {
            color: #d97706;
            gap: 8px;
        }

        .badge {
            background: #fef9e6;
            padding: 5px 12px;
            border-radius: 50px;
            font-size: 0.7rem;
            color: #b45309;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .countdown {
            background: #fff9e6;
            border-radius: 60px;
            padding: 12px 20px;
            margin: 20px 0;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
            color: #f59e0b;
            border: 1px solid #fde68a;
        }

        .countdown i {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .home-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            padding: 12px 30px;
            border-radius: 60px;
            text-decoration: none;
            font-weight: 600;
            margin-top: 15px;
            transition: all 0.3s ease;
        }

        .home-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(245, 158, 11, 0.4);
            gap: 12px;
        }

        .security-badge {
            position: fixed;
            bottom: 20px;
            left: 20px;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.6rem;
            color: #10b981;
            font-family: monospace;
            z-index: 999;
            pointer-events: none;
        }

        @media (max-width: 550px) {
            .lock-container {
                padding: 35px 25px;
                border-radius: 32px;
            }

            h1 {
                font-size: 1.4rem;
            }

            .lock-icon-wrapper {
                width: 70px;
                height: 70px;
            }

            .lock-icon-wrapper i {
                font-size: 32px;
            }

            .expiry-date {
                font-size: 0.9rem;
            }
        }
    </style>
</head>

<body>

    <div class="bg-animation">
        <div class="bubble bubble-1"></div>
        <div class="bubble bubble-2"></div>
        <div class="bubble bubble-3"></div>
        <div class="bubble bubble-4"></div>
    </div>

    <div class="flower flower-1">🌸</div>
    <div class="flower flower-2">🌼</div>
    <div class="flower flower-3">🌻</div>

    <div class="lock-container">
        <div class="lock-header">
            <div class="lock-icon-wrapper">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h1>
                <% 
// ✅ استخدام التاريخ من الخادم فقط
let now = new Date();
let expiry = null;
let expiryDateStr = '2 أبريل 2026';

// استخدام التاريخ من الخادم
if (typeof locals !== 'undefined' && locals.expiryDateRaw) {
    expiry = new Date(locals.expiryDateRaw);
    expiryDateStr = locals.expiryDate || '2 أبريل 2026';
} else {
    // قيمة افتراضية إذا لم يأت من الخادم
    expiry = new Date(2026, 3, 2, 23, 59, 59);
    expiryDateStr = '2 أبريل 2026';
}

const isExpired = now > expiry;
%>
                    <% if (isExpired) { %>
                        الموقع مغلق
                        <% } else { %>
                            بطاقات NFC الذكية
                            <% } %>
            </h1>
            <p class="subtitle">
                <% if (isExpired) { %>
                    أدخل كلمة المرور لفتح الموقع
                    <% } else { %>
                        منصتك المتكاملة للبطاقات الذكية
                        <% } %>
            </p>
        </div>

        <% if (isExpired) { %>
            <!-- الموقع مغلق - عرض نموذج كلمة المرور -->
            <div class="expiry-message">
                <i class="fas fa-calendar-times"></i>
                <p>⏰ انتهت صلاحية الموقع</p>
                <div class="expiry-date">
                    <i class="fas fa-clock"></i>
                    <%= expiryDateStr %>
                </div>
            </div>

            <div class="unlock-form">
                <form method="POST" action="/unlock-site" id="unlockForm">
                    <input type="hidden" name="csrf_token" id="csrfToken" value="">

                    <div class="form-group">
                        <div class="input-wrapper">
                            <i class="fas fa-key"></i>
                            <input type="password" name="password" id="passwordInput" placeholder="أدخل كلمة المرور"
                                required autofocus maxlength="100">
                        </div>
                    </div>

                    <% if (typeof error !=='undefined' && error) { const cleanError=String(error).replace(/[<>]/g, '');
                        %>
                        <div class="error-message">
                            <i class="fas fa-exclamation-circle"></i>
                            <span>
                                <%= cleanError %>
                            </span>
                        </div>
                        <% } %>

                            <button type="submit" id="submitBtn">
                                <i class="fas fa-unlock-alt"></i>
                                فتح الموقع
                                <i class="fas fa-arrow-left"></i>
                            </button>
                </form>

                <div class="note">
                    <span class="badge">
                        <i class="fas fa-info-circle"></i> للاستخدام الشخصي
                    </span>
                    <a href="https://wa.me/967772032403?text=السلام%20عليكم%20أحتاج%20مساعدة%20في%20الموقع"
                        target="_blank" id="contactLink"
                        style="background: linear-gradient(135deg, #25d366, #128C7E); color: white; padding: 10px 20px; border-radius: 60px; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600; transition: all 0.3s ease;">
                        <i class="fab fa-whatsapp" style="font-size: 1.2rem;"></i>
                        تواصل مع المبرمج عبر واتساب
                        <i class="fas fa-arrow-left"></i>
                    </a>
                </div>
            </div>
           <% } else { %>
    <!-- الموقع شغال -->
    <div class="active-message">
        <i class="fas fa-check-circle"></i>
        <h3>✅ الموقع يعمل بشكل طبيعي</h3>
        <p>جميع الخدمات متاحة وجاهزة للاستخدام</p>
        <div class="expiry-date">
            <i class="fas fa-hourglass-half"></i> متاح حتى: <%= expiryDateStr %>
        </div>
    </div>

    <div class="countdown">
        <i class="fas fa-hourglass-half"></i>
        <span>الموقع شغال حتى <%= expiryDateStr %></span>
    </div>

    <a href="/" class="home-link" id="homeLink">
        <i class="fas fa-home"></i>
        العودة للرئيسية
        <i class="fas fa-arrow-left"></i>
    </a>
<% } %>    </div>

    <script>
        // توليد CSRF Token
        function generateCSRFToken() {
            const array = new Uint8Array(32);
            if (window.crypto && window.crypto.getRandomValues) {
                window.crypto.getRandomValues(array);
            } else {
                for (let i = 0; i < array.length; i++) {
                    array[i] = Math.floor(Math.random() * 256);
                }
            }
            return Array.from(array, byte => byte.toString(16).padStart(2, '0')).join('');
        }

        const csrfToken = generateCSRFToken();
        const csrfInput = document.getElementById('csrfToken');
        if (csrfInput) csrfInput.value = csrfToken;

        // حماية نموذج الفتح من الإرسال المتعدد
        const form = document.getElementById('unlockForm');
        const submitBtn = document.getElementById('submitBtn');
        let isSubmitting = false;

        if (form && submitBtn) {
            form.addEventListener('submit', function (e) {
                if (isSubmitting) {
                    e.preventDefault();
                    return;
                }

                const token = document.getElementById('csrfToken');
                if (token && token.value !== csrfToken) {
                    e.preventDefault();
                    alert('🔒 خطأ في التحقق الأمني! يرجى تحديث الصفحة');
                    return;
                }

                isSubmitting = true;
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="loading-spinner"></span> جاري التحقق...';

                setTimeout(() => {
                    isSubmitting = false;
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-unlock-alt"></i> فتح الموقع <i class="fas fa-arrow-left"></i>';
                }, 5000);
            });
        }

        // إضافة مؤشر تحميل للزر
        const style = document.createElement('style');
        style.textContent = `
            .loading-spinner {
                display: inline-block;
                width: 16px;
                height: 16px;
                border: 2px solid rgba(255,255,255,.3);
                border-radius: 50%;
                border-top-color: white;
                animation: spinnerSpin 1s ease-in-out infinite;
                margin-left: 8px;
            }
            @keyframes spinnerSpin {
                to { transform: rotate(360deg); }
            }
        `;
        document.head.appendChild(style);

        console.log('📅 تاريخ انتهاء الصلاحية: 31 مارس 2026');
    </script>
</body>

</html>